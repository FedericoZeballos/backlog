{
  "name": "backlog",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db": "npm run db -w @backlog/api",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @backlog/api",
    "dev:web": "npm run dev -w @backlog/web",
    "create-admin": "npm run create-admin -w @backlog/api --",
    "build": "npm run build -w @backlog/web",
    "test": "npm test --workspaces --if-present",
    "e2e": "npm run e2e -w @backlog/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
