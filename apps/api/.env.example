# Base de datos local levantada con `npm run db` (embedded-postgres).
DATABASE_URL="postgresql://backlog:backlog@localhost:5433/backlog"

PORT=3000
# URL pública del frontend; se usa para armar los links de invitación.
APP_URL="http://localhost:5173"
# Poner en true cuando se sirva por HTTPS.
COOKIE_SECURE=false

# IA (fase 5). Sin clave, la app usa el modo de prueba `fake`.
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL="http://localhost:11434"
