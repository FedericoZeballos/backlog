# Base de datos local levantada con `npm run db` (embedded-postgres).
DATABASE_URL="postgresql://backlog:backlog@localhost:5433/backlog"

PORT=3000
# URL pública del frontend; se usa para armar los links de invitación.
APP_URL="http://localhost:5173"
# Poner en true cuando se sirva por HTTPS.
COOKIE_SECURE=false

# Asistente de IA. Cada usuario puede cambiar proveedor y modelo en Configuración;
# esto define el valor por defecto. Proveedores: OLLAMA, ANTHROPIC o FAKE (modo de prueba).
AI_PROVIDER=OLLAMA
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# qwen2.5:7b: mejor calidad, 2-4 min por respuesta con 4 GB de video.
# qwen2.5:3b: entra entero en la placa, ~30-50 s, respuestas más flojas.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192
# Claude (opcional). La clave nunca se envía al navegador.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=360000
